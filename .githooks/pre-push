#!/bin/sh
# Git pre-push hook: Prevents direct pushes to the main branch while allowing all other branches.

while read -r local_ref local_oid remote_ref remote_oid; do
    if [ "$remote_ref" = "refs/heads/main" ] || [ "$remote_ref" = "refs/heads/master" ]; then
        echo "" >&2
        echo "=================================================================" >&2
        echo " [GIT HOOK ERROR] Direct push to '$remote_ref' is strictly forbidden!" >&2
        echo " Please push to a feature/fix branch and open a Pull Request." >&2
        echo "=================================================================" >&2
        echo "" >&2
        exit 1
    fi
done

exit 0
